  "narrative": {
    "northStar": "The Phlebotomy Tray",
    "overview": "Nursing students know collection tubes by heart: cap colors, the order of draw, the fill line. Each Client Needs area is a tube with its own cap color and every score is a fill level. The rest of the tray is clear plastic on cool grey, white label stock and specimen-label ink.",
    "keyCharacteristics": [
      "Eight cap colors, one per Client Needs area",
      "Scores as tube fill levels",
      "Wide Archivo caps like printed tube labels",
      "Atkinson Hyperlegible for every stem and choice",
      "Ink buttons and a reverse-printed active tab"
    ],
    "rules": [
      {
        "name": "Cap Law",
        "body": "Cap colors appear only as caps, fills and area swatches, always beside the area name.",
        "section": "colors"
      },
      {
        "name": "Red Means Wrong",
        "body": "Red is kept for wrong answers and alerts.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use a cap color only for its area",
      "Do scale reading text with --fs"
    ],
    "donts": [
      "Don't use cream or paper grounds, serif type, gold, saffron or purple",
      "Don't use color alone to show right or wrong"
    ]
